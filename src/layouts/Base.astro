---
import { siArxiv, siGithub, siGooglescholar } from 'simple-icons';
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/global.css';

const { frontmatter } = Astro.props;
const siteName = 'Jeremy Lane';
const pageTitle =
  frontmatter?.title && frontmatter.title !== 'Home'
    ? `${frontmatter.title} | ${siteName}`
    : siteName;
const description =
  frontmatter?.description ?? 'Jeremy Lane: applied scientist and mathematician.';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/cv/', label: 'CV' },
];
const path = Astro.url.pathname;

// Simple Icons no longer ships LinkedIn, so this is a hand-drawn "in" mark.
const linkedinPath =
  'M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z' +
  'M6 7.5a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0-3 0z' +
  'M6 10h3v8H6z' +
  'M11 10h2.8v1.2c.5-.8 1.5-1.4 2.8-1.4 2.2 0 3.4 1.4 3.4 3.9V18h-3v-3.8c0-1.1-.4-1.8-1.4-1.8s-1.6.7-1.6 1.8V18h-3z';

const social = [
  { href: 'https://github.com/lanejere5', label: 'GitHub', icon: siGithub.path },
  { href: 'https://arxiv.org/a/lane_j_2.html', label: 'arXiv', icon: siArxiv.path },
  {
    href: 'https://scholar.google.ca/citations?user=atcyxVwAAAAJ&hl=en',
    label: 'Google Scholar',
    icon: siGooglescholar.path,
  },
  { href: 'https://www.linkedin.com/in/lanejere5', label: 'LinkedIn', icon: linkedinPath },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply a saved theme before first paint so there's no flash.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">{siteName}</a>
      <nav>
        {nav.map(({ href, label }) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
        ))}
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" />
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </nav>
    </header>
    <main class={frontmatter?.class}>
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Elsewhere">
        {social.map(({ href, label, icon }) => (
          <a href={href} rel="me noopener" target="_blank">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill-rule="evenodd"><path d={icon} /></svg>
            {label}
          </a>
        ))}
      </nav>
      <p>© {year} {siteName}</p>
    </footer>
    <script>
      const root = document.documentElement;
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const isDark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
